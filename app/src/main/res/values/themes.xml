<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Gymrat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gym_primary</item>
        <item name="colorPrimaryVariant">@color/gym_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/gym_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/gym_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="GymInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_text_input</item>

        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="hintTextColor">@color/gym_primary</item>

        <item name="android:textColorHint">#99FFFFFF</item>

        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>