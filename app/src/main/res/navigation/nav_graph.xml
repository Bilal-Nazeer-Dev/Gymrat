<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.gymrat.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_onboardingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.gymrat.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signupFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right" />

        <action
            android:id="@+id/action_loginFragment_to_setupProfileFragment"
            app:destination="@id/setupProfileFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.gymrat.SignupFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup">

        <action
            android:id="@+id/action_signupFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right" />

        <action
            android:id="@+id/action_signupFragment_to_setupProfileFragment"
            app:destination="@id/setupProfileFragment"
            app:popUpTo="@id/signupFragment"
            app:popUpToInclusive="true"/>

        <action
            android:id="@+id/action_signupFragment_to_verificationFragment"
            app:destination="@id/verificationFragment" />
    </fragment>

    <fragment android:id="@+id/verificationFragment" android:name="com.example.gymrat.VerificationFragment" tools:layout="@layout/fragment_verification">
        <action android:id="@+id/action_verificationFragment_to_homeFragment" app:destination="@id/homeFragment" />
        <action android:id="@+id/action_verificationFragment_to_setupProfileFragment" app:destination="@id/setupProfileFragment" />
    </fragment>

    <fragment android:id="@+id/setupProfileFragment" android:name="com.example.gymrat.SetupProfileFragment" tools:layout="@layout/fragment_setup_profile">
        <action android:id="@+id/action_setupProfileFragment_to_homeFragment" app:destination="@id/homeFragment" app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/homeFragment" android:name="com.example.gymrat.HomeFragment" tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_homeFragment_to_chatFragment" app:destination="@id/chatFragment" />
        <action android:id="@+id/action_homeFragment_to_profileFragment" app:destination="@id/profileFragment" />
        <action android:id="@+id/action_homeFragment_to_workoutsFragment" app:destination="@id/workoutsFragment" />
        <action android:id="@+id/action_homeFragment_to_dietFragment" app:destination="@id/dietFragment" />
        <action android:id="@+id/action_homeFragment_to_attendanceFragment" app:destination="@id/attendanceFragment" />
        <action android:id="@+id/action_homeFragment_to_bmiFragment" app:destination="@id/bmiFragment" />
    </fragment>

    <fragment android:id="@+id/attendanceFragment" android:name="com.example.gymrat.AttendanceFragment" tools:layout="@layout/fragment_attendance" />
    <fragment android:id="@+id/bmiFragment" android:name="com.example.gymrat.BmiFragment" tools:layout="@layout/fragment_bmi" />
    <fragment android:id="@+id/chatFragment" android:name="com.example.gymrat.ChatFragment" tools:layout="@layout/fragment_chat" />
    <fragment android:id="@+id/profileFragment" android:name="com.example.gymrat.ProfileFragment" tools:layout="@layout/fragment_profile">
        <action android:id="@+id/action_profileFragment_to_loginFragment" app:destination="@id/loginFragment" app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
        <action android:id="@+id/action_profileFragment_to_editProfileFragment" app:destination="@id/editProfileFragment" />
    </fragment>
    <fragment android:id="@+id/editProfileFragment" android:name="com.example.gymrat.EditProfileFragment" tools:layout="@layout/fragment_edit_profile" />

    <fragment android:id="@+id/workoutsFragment" android:name="com.example.gymrat.WorkoutsFragment" tools:layout="@layout/fragment_workouts">
        <action android:id="@+id/action_workoutsFragment_to_workoutDetailFragment" app:destination="@id/workoutDetailFragment" />
    </fragment>
    <fragment android:id="@+id/workoutDetailFragment" android:name="com.example.gymrat.WorkoutDetailFragment" tools:layout="@layout/fragment_workout_detail">
        <action android:id="@+id/action_workoutDetailFragment_to_activeWorkoutFragment" app:destination="@id/activeWorkoutFragment" />
    </fragment>
    <fragment android:id="@+id/activeWorkoutFragment" android:name="com.example.gymrat.ActiveWorkoutFragment" tools:layout="@layout/fragment_active_workout">
        <action android:id="@+id/action_activeWorkoutFragment_to_homeFragment" app:destination="@id/homeFragment" app:popUpTo="@id/homeFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/dietFragment" android:name="com.example.gymrat.DietFragment" tools:layout="@layout/fragment_diet">
        <action android:id="@+id/action_dietFragment_to_dietDetailFragment" app:destination="@id/dietDetailFragment" />
    </fragment>
    <fragment android:id="@+id/dietDetailFragment" android:name="com.example.gymrat.DietDetailFragment" tools:layout="@layout/fragment_diet_detail" />

</navigation>